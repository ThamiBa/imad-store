{
  "name": "imad-store",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev": "npx turbo run dev",
    "build": "npm --prefix packages/shared run build && npm --prefix apps/web run build && node scripts/copy-standalone-assets.js",
    "start": "node server.js",
    "lint": "npx turbo run lint"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.8.3",
    "turbo": "^2.9.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "express-rate-limit": "^8.7.0",
    "googleapis": "^178.0.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.50.0",
    "react-is": "^18.3.1",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.5",
    "zod": "^4.6.5"
  }
}
