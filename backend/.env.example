# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ─── Database (MongoDB Atlas — FREE) ─────────────────────
# 1. Go to: cloud.mongodb.com → Create Free Cluster (M0)
# 2. Create a database user (username + password)
# 3. Whitelist your IP (or use 0.0.0.0/0 for all IPs)
# 4. Click "Connect" → "Compass" → copy the URI, change <password>
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/imad-store?retryWrites=true&w=majority"

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=your-super-secret-key-minimum-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-minimum-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Stripe (test mode is free) ──────────────────────────
# dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (Gmail SMTP — free) ───────────────────────────
# myaccount.google.com → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=your-gmail@gmail.com

# ─── WhatsApp ────────────────────────────────────────────
WHATSAPP_PHONE=212XXXXXXXXX
