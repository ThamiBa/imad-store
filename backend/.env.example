# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ─── Database (MongoDB Atlas) ──────────────────────────
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/imad-store"

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (Resend or Gmail SMTP) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=noreply@yourdomain.com
RESEND_API_KEY=re_...

# ─── Telegram Bot (the bridge hub) ──────────────────────
# 1. Chat with @BotFather on Telegram → /newbot
# 2. Copy the bot token below
# 3. Send any message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Your chat id is the numeric value under "chat":{"id":...}
# 4. Register the webhook with Telegram (run once after deployment):
#    curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://YOUR_API/api/telegram/webhook"
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ─── WhatsApp (FREE — no Twilio, no API key) ────────────
# These are just phone numbers used to generate wa.me links.
# The admin reads order notifications on Telegram and replies from WhatsApp.
# STORE_WHATSAPP_PHONE — the customer-facing number (shown in success page CTA)
# WHATSAPP_PHONE        — the admin's personal number (used for admin notifications)
STORE_WHATSAPP_PHONE=212XXXXXXXXX
WHATSAPP_PHONE=212XXXXXXXXX

# ─── Google Sheets ───────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
