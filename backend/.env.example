# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ─── Database (MongoDB Atlas) ──────────────────────────
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/imad-store"

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (Resend or Gmail SMTP) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=noreply@yourdomain.com

# ─── WhatsApp (Twilio) ──────────────────────────────────
# 1. Sign up on twilio.com
# 2. Get Account SID and Auth Token from your Twilio Console
# 3. Enter your Twilio WhatsApp sender number (default twilio sandbox is whatsapp:+14155238886)
# 4. Set your notification phone number in WHATSAPP_PHONE to receive order updates
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_PHONE=212XXXXXXXXX
