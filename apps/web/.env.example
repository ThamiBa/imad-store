# Environment Variables for imad-store Frontend

# API URL for the backend service
# In production, this should be set to your deployed backend URL (e.g., https://api.imad-store.com)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# WhatsApp phone number for order notifications (used in checkout page)
# Format: include country code without spaces or special characters (e.g., 212660560522)
NEXT_PUBLIC_WHATSAPP_PHONE=212660560522